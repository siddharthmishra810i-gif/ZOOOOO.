        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specimenIds: [\'beroe\', \'ctenoplana\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    revisionPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Locomotion executed by 8 meridional rows of ciliated comb plates (ctenes).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possess sticky adhesive cells called Colloblasts (lasso cells) instead of cnidocytes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possess an apical sensory statocyst at the aboral pole governing equilibrium.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Display biradial symmetry with paired tentacles and a pharyngeal axis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibit bright bioluminescence and optical rainbow diffraction along ctenes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Completely lack stinging nematocysts (non-stinging jellies).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Development typically includes a free-swimming spherical Cydippid larva.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomicalDiagram: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Aboral Sensory Statocyst & Comb Row Coordination\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Equilibrium organ synchronizing the 8 ciliated comb plates for swimming\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsOrParts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Statolith\', description: \'Central cluster of calcareous granules resting atop four balancers.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Balancers (Sensory Cilia)\', description: \'Four mechanoreceptor tufts supporting the statolith.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Ciliated Grooves\', description: \'Bifurcating nerve-like tracts running from balancers to comb rows.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Comb Rows (Ctenes)\', description: \'Plates of fused giant cilia executing power and recovery strokes.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Bell-Shaped Dome\', description: \'Transparent protective cuticular cupola enclosing the sensory statocyst.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
