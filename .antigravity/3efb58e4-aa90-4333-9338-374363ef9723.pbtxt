          text: "  const filteredSpecimens = specimensData.filter((specimen) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const matchesPhylum = selectedPhylum === \'all\' || specimen.phylumId === selectedPhylum;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const query = searchQuery.toLowerCase().trim();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const matchesSearch ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      query === \'\' ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.commonName.toLowerCase().includes(query) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.scientificName.toLowerCase().includes(query) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.phylumId.toLowerCase().includes(query) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.habitat.toLowerCase().includes(query) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.identification.toLowerCase().includes(query) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      specimen.specialFeatures.toLowerCase().includes(query);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return matchesPhylum && matchesSearch;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
