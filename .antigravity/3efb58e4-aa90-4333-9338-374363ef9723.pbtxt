        }
        lines {
          text: "    commonName: \'Cloak Anemone\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Adamsia palliata\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
