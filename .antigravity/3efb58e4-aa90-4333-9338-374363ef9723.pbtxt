        lines {
          text: "        { name: \'Ciliary Flame Tuft\', description: \'Bundle of 50\342\200\223100 vibrating flagella resembling a flickering candle flame.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Slit Interdigitations\', description: \'Internal fenestrated filtration slits between terminal cell and tubule cell.\' },"
