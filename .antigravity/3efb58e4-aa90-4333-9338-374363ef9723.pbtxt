          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    scientificName: \'Gorgonia flabellum\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
