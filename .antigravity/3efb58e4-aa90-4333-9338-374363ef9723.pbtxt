        }
        lines {
          text: "    spotlightQuote: \'A massive hermatypic coral whose meandering labyrinth of valleys and ridges mirrors the convolutions of the human cerebrum.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Massive hemispherical stony coral featuring winding, sinuous corallite valleys separated by steep ridges resembling human cerebral gyri.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Shallow to mid-depth tropical reefs (3\342\200\22330 m) throughout the Caribbean Sea, Bahamas, and Gulf of Mexico.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Forms solid hemispherical domes or robust columnar boulders up to 1 meter in diameter. The skeletal surface is covered in deep, meandering valleys (1\342\200\2232 cm wide) that wind continuously across the surface. At night, translucent tentacles expand from the valleys to feed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A colonial scleractinian with meandroid corallite integration: adjacent polyps fuse linearly within the valleys, sharing a common gastrovascular groove and mouth series while retaining distinct septal ridges (collines). The skeleton is dense, massive aragonite.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Mixotrophic: daytime nutrition from symbiotic zooxanthellae; nocturnal extension of sweeping tentacular nets to capture pelagic zooplankton.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Simultaneous hermaphroditic broadcast spawner during late-summer lunar spawning events; planulae settle to begin new colonies.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Meandroid colony integration; deep robust septa with fine denticulations; high structural density providing storm resistance to Caribbean reefs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Primary framework builder of Western Atlantic coral reefs; provides immense calcium carbonate accretion and shoreline wave protection.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Colonies can live for over 400 years, with annual growth bands in their skeletons recording past ocean temperatures like tree rings.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Despite looking like a single brain, the colony contains thousands of interconnected individual coral polyps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possesses extraordinary resistance to heavy sedimentation by producing self-cleaning mucus sheets.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia, Order: Scleractinia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits Meandroid colony growth where corallites fuse into continuous winding valleys.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeletal ridges are called Collines; valleys contain the oral apertures.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Major Hermatypic (reef-building) coral with aragonite skeleton.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'madrepora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Staghorn / Branching Coral\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Madrepora oculata\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Hexacorallia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Scleractinia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Madrepora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'oculata\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-013\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A prolific branching deep-water stony coral that builds cold-water reef sanctuaries in pitch-black abyssal trenches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Branching colonial scleractinian with delicate zigzag branches and prominent protruding cylindrical corallites.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Cosmopolitan deep cold-water reefs (80\342\200\2231,500 m) in total darkness, as well as shallow tropical reefs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Bushy, dichotomously branching colonies up to 50 cm high. The branches follow a distinctive zigzag or alternating path, with prominent cup-like corallites (thecae) projecting alternately along opposite sides of the white or pale pink skeleton.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Hexacorallian stony coral with polyps possessing 12 to 24 tentacles. Because it thrives in dark, cold deep-sea environments, it lacks photosynthetic zooxanthellae (azooxanthellate coral) and relies 100% on external prey capture.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Strict carnivore: feeds on descending particulate organic carbon, copepods, and krill drifting along deep sea contours.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Dioecious with broadcast spawning; planula larvae drift for weeks across deep oceanic currents before settling on hard rocks.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Azooxanthellate (lacks symbiotic algae); thrives in cold water down to 4\302\260C; zigzag branching architecture with alternating corallites.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Critical foundation species of global deep-sea coral reef ecosystems, providing nursery grounds for commercial deep-sea fish species.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Unlike tropical reef corals, Madrepora builds entire mountain-sized reefs in complete pitch-black darkness without a ray of sunlight.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Deep-sea fishing trawlers severely threaten its fragile, centuries-old branching thickets.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its specific name \"oculata\" means \"bearing eyes,\" referring to the round, eye-like corallite cups along the branches.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia, Order: Scleractinia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits alternating/zigzag branching with prominent projecting corallites.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Often Azooxanthellate (cold-water deep-sea coral independent of sunlight).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Produces a porous, branching aragonite exoskeleton.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // ================= CTENOPHORA ================="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
