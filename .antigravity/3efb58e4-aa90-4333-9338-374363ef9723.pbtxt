        lines {
          text: "    accessionNo: \'INV-CTE-001\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A voracious pelagic hunter with an enormous gaping mouth, lacking tentacles and swallowing other comb jellies whole.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Thimble- or melon-shaped transparent pelagic comb jelly that completely lacks tentacles, propelled by eight iridescent ciliated comb rows.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Cold and temperate marine pelagic waters, common in Arctic, Atlantic, and North Pacific coastal and offshore waters.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Mitre-shaped, cylindrical, or thimble-shaped gelatinous body (5\342\200\22315 cm long), laterally compressed with a wide, gaping oral aperture occupying the entire anterior end. Eight longitudinal meridional comb rows (ctenes) extend from the aboral pole down 3/4 of the body. Color is pinkish-translucent with shimmering rainbow fringes along the ctenes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Belongs to Class Nuda: completely lacks tentacles, tentacle sheaths, and colloblasts at all life stages. The interior is largely taken up by an enormous stomodeal pharynx lined with macrocilia that act like teeth to cut and ingest prey. Eight branching meridional gastrovascular canals radiate beneath the comb plates.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Hyper-carnivorous apex gelatinous predator: preys almost exclusively on other ctenophores (such as Pleurobrachia and Bolinopsis). It engulfs prey whole, sealing its enormous lips with biological adhesive strips, and uses muscular churning to digest them in minutes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Hermaphroditic; gametes shed into the sea; external fertilization produces a direct-developing cydippid-like form that lacks tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Completely devoid of tentacles (Class Nuda); giant oral lips lined with macroscopic fused cilia (macrocilia) serving as cutting teeth; dazzling bioluminescence and ciliary optical iridescence.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Natural biological control agent of other ctenophore populations; introduced into the Black Sea where it successfully curtailed invasive Mnemiopsis blooms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The \"rainbows\" running along its body are not bioluminescence, but the physical diffraction of white light by millions of coordinated beating cilia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Can swallow another ctenophore larger than itself by stretching its elastic muscular pharynx like an anaconda.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its lips feature microscopic chemical velcro-like structures that seal the mouth shut during digestion.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Nuda (Atentaculata) \342\200\224 completely lacks tentacles and colloblasts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possesses 8 meridional ciliated comb rows (ctenes) used for locomotion.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Mouth is enormous, leading directly into an expansive pharynx.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Aboral pole bears a single Statocyst (equilibrium sense organ).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Feeds as a predator on tentaculate ctenophores.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'ctenoplana\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Creeping Comb Jelly\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Ctenoplana kowalevskii\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'ctenophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Ctenophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Tentaculata\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Platyctenida\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Ctenoplana\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'kowalevskii\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CTE-002\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A bizarre evolutionary intermediate: a comb jelly that abandoned open-water swimming to creep like a flatworm over corals.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Dorsoventrally flattened, benthic creeping ctenophore resembling a flatworm, with reduced comb plates and two long retractile tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Warm tropical shallow marine waters, creeping over alcyonarian soft corals, gorgonians, and echinoderms in the Indo-West Pacific.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Flattened, disc-like or oval body (6\342\200\22310 mm across) adapted for creeping. The dorsal surface is brightly mottled with green, brown, or red patterns. The ventral surface is pale and flat, serving as a creeping sole. Eight tiny comb rows are reduced to short segments around the central aboral statocyst.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Remarkable anatomical modification of the ctenophore plan: the oral-aboral axis is compressed dorsoventrally. Two deep lateral tentacle sheaths house long pinnate tentacles armed with sticky colloblasts. The stomodeum is turned outward (everted) across the ventral surface to secrete mucus and creep over benthic surfaces.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Carnivorous: creeps over soft coral colonies, extending its two long feathery tentacles into water currents to trap copepods and larvae on sticky colloblasts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Hermaphroditic; internal fertilization occurs in brood chambers; development produces a typical free-swimming cydippid larva that settles to the seafloor.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Benthic creeping lifestyle; extreme dorsoventral flattening; reduced comb plates; represents an astonishing convergence toward the platyhelminth (flatworm) body form.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Classic evolutionary link historically studied by zoologists investigating the transition between Radiata and Bilateria.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When first discovered by Kowalevsky in 1880, biologists argued for decades whether it was a modified jellyfish or a walking worm.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'It can swim briefly if detached from substrate by flapping the lateral margins of its flattened body.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its reduced comb rows beat only occasionally, functioning primarily as sensory aids rather than swimming oars.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Tentaculata, Order: Platyctenida.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body is dorsoventrally flattened and modified for creeping on substrate (benthic).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Comb rows are reduced to 8 short rudimentary plates surrounding the aboral statocyst.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possesses two retractile tentacles equipped with Colloblasts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Serves as a classic example of evolutionary convergence toward a flatworm-like habit.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // ================= PLATYHELMINTHES ================="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'fasciola\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Sheep Liver Fluke\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Fasciola hepatica\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'platyhelminthes\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Platyhelminthes\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Trematoda (Digenea)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Echinostomida\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Fasciola\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'hepatica\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-PLA-001\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A leaf-shaped endoparasitic trematode causing liver rot, equipped with an oral sucker and a branched blind intestine.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Dorsoventrally flattened, leaf-shaped endoparasitic fluke infecting the bile ducts of sheep, cattle, and humans, requiring a freshwater snail as an intermediate host.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Endoparasite residing in the bile ducts and liver tissue of sheep, cattle, and occasionally humans; intermediate host is the freshwater pond snail (Lymnaea).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Flat, leaf-like body measuring 20 to 30 mm long and 8 to 13 mm wide, greyish-pink or pale brown with transparent lateral margins. The anterior end tapers into a triangular cephalic cone with a terminal oral sucker. A second cup-shaped muscular sucker, the ventral sucker (acetabulum), is located just behind the neck for attachment.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Covered by a thick, syncytial, spiny tegument protecting it against host bile and digestive enzymes. Incomplete digestive system: mouth leads to a muscular pharynx and two deeply branched intestinal caeca ending blindly (no anus). Flame cells drain into a median longitudinal excretory duct opening via a posterior excretory pore. Ladder-like nervous system with paired cerebral ganglia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Feeds on host blood, bile, and liver cells sucked into its muscular pharynx and digested in branched intestinal caeca.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Hermaphroditic (monoecious) with an exceptionally complex reproductive system: highly branched dendritic testes, single tubular branched ovary, extensive lateral vitelline glands, and convoluted uterus. Copulation via cirrus leads to production of thousands of operculated eggs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lifeCycle: \'Digenetic life cycle requiring two hosts: Adult in sheep bile ducts \342\206\222 Operculated eggs passed in feces \342\206\222 Miracidium larva (ciliated) enters Lymnaea snail \342\206\222 Sporocyst \342\206\222 Redia (1st & 2nd gen) \342\206\222 Cercaria (tailed) leaves snail \342\206\222 Encysts on grass blades as Metacercaria \342\206\222 Ingested by sheep/cattle \342\206\222 Excysts in duodenum and migrates to liver.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Digenetic life cycle involving five distinct larval stages (Miracidium, Sporocyst, Redia, Cercaria, Metacercaria); extensive polyembryony inside the snail host.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Causes Fascioliasis (\"liver rot\") in livestock, leading to massive global agricultural losses and human zoonotic infections.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'A single miracidium penetrating a snail can amplify through polyembryony into over 500 swimming cercaria larvae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Humans contract the parasite by eating raw wild watercress contaminated with encysted metacercariae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Adult flukes can live in human bile ducts for up to 12 years, feeding continuously on blood.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Trematoda, Subclass: Digenea (two hosts: Primary host = Sheep/Human; Intermediate host = Lymnaea snail).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body is leaf-like, acoelomate, triploblastic, and dorsoventrally flattened.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Two suckers: Oral sucker (feeding/attachment) and Ventral sucker / Acetabulum (attachment only).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Digestive system is incomplete with branched blind-ended intestinal caeca (no anus).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Excretion and osmoregulation executed by Flame Cells (protonephridia).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Five larval stages in order: Miracidium \342\206\222 Sporocyst \342\206\222 Redia \342\206\222 Cercaria \342\206\222 Metacercaria.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomicalFlow: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Fasciola hepatica Digenetic Life Cycle Stages\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      path: [\'Egg in Feces\', \'Miracidium (enters snail)\', \'Sporocyst\', \'Redia\', \'Cercaria (leaves snail)\', \'Metacercaria (on grass)\', \'Adult in Sheep Liver\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'The digenetic cycle alternates between sexual reproduction in the primary mammalian host and massive asexual polyembryony in the intermediate freshwater snail.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
