          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fact: \'The flashing rainbow bands along the body of Beroe are not bioluminescence, but the physical refraction of ambient light by millions of coordinated beating cilia in its comb rows.\',"
