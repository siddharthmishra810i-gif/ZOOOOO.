        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'sycon\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Scypha / Crown Sponge\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Sycon ciliatum\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Calcarea (Calcispongiae)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Heterocoela\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Sycon\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'ciliatum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-POR-001\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A canonical marine sponge illustrating the architectural elegance of syconoid canal dynamics.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Small urn-shaped solitary or colonial marine sponge with a prominent crown of calcareous monaxon spicules fringing its terminal osculum.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Urn-shaped or vase-like cylindrical body with alternating incurrent and radial canals and a bristly oscular collar.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Marine shallow coastal waters, permanently attached to rocks, shells, and pilings in sheltered littoral zones.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Body measures 2 to 7 cm in height, pale cream to yellowish-brown, consisting of slender cylindrical tubes branching from a common basal stolon. The summit features a large aperture, the osculum, encircled by a prominent crown of long, monaxon calcareous spicules preventing entry of foreign debris. The lateral body wall is perforated by thousands of microscopic incurrent ostia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Sycon exhibits syconoid body wall folding: outer pinacoderm is indented to form incurrent canals, while the inner choanoderm is folded outward into radial canals lined with active choanocytes. Between the incurrent and radial canals lie microscopic prosopyles. The radial canals empty via apopyles into the central spongocoel lined with pinacocytes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Filter-feeding on suspended phytoplankton, bacteria, and fine organic detritus. Choanocyte flagella generate an inward water current. Food particles adhere to mucus collars, are engulfed by pinacocytosis/phagocytosis, and transferred to amoebocytes (thesocytes and trophocytes) for intracellular enzymatic hydrolysis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Reproduces asexually by budding and regeneration; sexually by internal fertilization. Hermaphroditic (protogynous); choanocytes capture incoming sperm, transport them to mature ova in the mesohyl. Development yields a characteristic free-swimming ciliated amphiblastula larva with micromeres and macromeres.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lifeCycle: \'Zygote undergoes holoblastic unequal cleavage to form a blastula with micromeres bearing flagella directed inward (stomoblastula). The blastula inverts (inversion stage), passes through the maternal radial canal, and is expelled via the osculum as a free-swimming amphiblastula that settles on rock and metamorphoses into an olynthus stage.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Classic syconoid canal system with folded body walls; mineral skeleton composed of calcareous monaxon, triaxon, and tetraxon calcite spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Fundamental textbook archetype in comparative invertebrate zoology; contributes to coastal benthic particulate matter filtration and benthic-pelagic coupling.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Inverts inside-out during embryogenesis through a unique process called stomoblastula inversion.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'A single Sycon can pump more than 20 liters of seawater through its body per day relative to its tiny mass.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its spicular crown acts as an exclusionary grill to prevent amphipods and debris from entering the osculum.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Belongs to Class Calcarea due to calcium carbonate spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Displays Syconoid canal system: Ostia \342\206\222 Incurrent Canal \342\206\222 Prosopyle \342\206\222 Radial Canal \342\206\222 Apopyle \342\206\222 Spongocoel \342\206\222 Osculum.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Choanocytes are restricted solely to the radial canals, not the spongocoel.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Larva is an Amphiblastula with anterior flagellated cells and posterior non-flagellated cells.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Pinacoderm is formed of flattened pinacocytes and contractile porocytes.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomicalFlow: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Water Current Direction in Sycon\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      path: [\'Dermal Ostia\', \'Incurrent Canals\', \'Prosopyles\', \'Radial Canals (Choanocytes)\', \'Apopyles\', \'Spongocoel\', \'Osculum\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'The rhythmic undulation of choanocyte flagella drives incoming water through microscopic ostia and expels it forcefully through the osculum.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'hyalonema\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Glass Rope Sponge\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Hyalonema sieboldi\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Hexactinellida (Hyalospongiae)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Amphidiscophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Hyalonema\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'sieboldi\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-POR-002\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A deep-sea marvel anchored into abyssal ooze by a luminous spiral cable of twisted fiberglass-like spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Deep-sea hexactinellid sponge anchored to the abyssal muddy floor by a long, twisted bundle of silicious glass fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Rounded or cup-shaped sponge body anchored into ocean mud by a long spirally twisted root rope of silicious glass spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    habitat: \'Abyssal and bathyal marine waters between 1,000 and 4,000 meters depth, commonly in the Indo-Pacific and Atlantic basins.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Consists of two distinct portions: an apical rounded or cup-shaped sponge body (10\342\200\22330 cm) and an elongated basal root tuft (rope) measuring up to 1 meter in length. The root tuft comprises dozens of spirally twisted, ultra-pure silicious spicules that penetrate deep into soft ocean mud.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Body wall is formed of a syncytial hexactinellid reticulum without cellular boundaries. The skeletal framework consists of six-rayed (hexactine) and amphidisc silicious spicules. The central axis is penetrated by a columella around which the sponge body is organized.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Deep-sea filter feeder feeding on marine snow, suspended organic matter, and bathypelagic bacteria transported by abyssal bottom currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Sexual reproduction produces stereogastrula / parenchymula larvae; possesses high regenerative capacity common to hexactinellids.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'The twisted silicious stalk contains natural optical-fiber-grade glass spicules that conduct ambient light in the abyss. Almost always hosts colonial commensal zoanthid anemones (Epizoanthus) encrusting the stalk.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Natural optical biomaterial studied by materials scientists for bio-silicification and low-temperature fiber-optic synthesis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Early naturalists mistakenly classified the sponge body and its encrusting Epizoanthus anemones as two halves of a mythical hybrid organism.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its root spicules have optical properties superior to synthetic commercial fiber-optic cables in fracture toughness.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Can survive centuries in the calm, frigid conditions of the ocean abyss.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Belongs to Class Hexactinellida characterized by 6-rayed silicious spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possesses amphidisc spicules (spicules with umbrella-like discs at both ends).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Distinguished by a twisted spiraling stalk of silicious anchoring threads (glass rope).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits obligate commensalism with Epizoanthus polyps covering the stalk.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'euplectella\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \"Venus\' Flower Basket\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Euplectella aspergillum\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Hexactinellida\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Hexasterophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Euplectella\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'aspergillum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-POR-003\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'An ethereal latticed vase of spun glass that serves as an eternal oceanic sanctuary for paired commensal shrimp.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Exquisite cylindrical glass sponge with a curved cornucopia-like skeleton composed of fused triaxon silicious spicules forming a geometric lattice.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Deep-sea benthic zones, especially rocky or sedimented slopes around the Philippines and Western Pacific (500\342\200\2231,000 m).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Curved, tubular, vase-shaped body (15\342\200\22330 cm long) anchored into the substrate by a dense tuft of delicate basal spicular root fibers. The upper terminal opening is closed by a perforated silicious sieve-plate (oscular sieve). The body wall exhibits a regular square and diagonal structural lattice.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Lacks a pinacoderm layer; the external surface is covered by a syncytial trabecular network. Choanocytes are contained in thimble-shaped flagellated chambers. Skeleton is a masterpiece of architectural engineering: three-rayed silicious spicules fused together with colloidal silica to form an indestructible geodesic cylinder.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Microscopic filter feeder utilizing water currents drawn inward through parietal gaps into flagellated chambers and expelled through the terminal sieve-plate.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Sexual reproduction leads to parenchymula larvae that drift until settling on bathyal substrata.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'A male and female pair of small commensal shrimp (Spongicola venusta) enter the sponge body during their larval stage, grow inside the secure lattice, and become permanently imprisoned for life.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Celebrated in Japanese tradition as a wedding gift symbolizing eternal matrimonial fidelity until death; model system in biomimetic structural engineering for earthquake-resistant skyscraper architecture.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'In Japan, dried specimens with the two imprisoned shrimp inside are given as traditional wedding presents representing \"Together until old age and beyond.\"\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Architects and NASA engineers study Euplectella\342\200\231s lattice ribs to design lightweight, high-strength aerospace structures.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The glass spicules contain concentric layers of organic glue that prevent microscopic cracks from propagating.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Hexactinellida, Order: Hexasterophora (possesses hexaster spicules).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton consists of fused silicious spicules forming a rigid, non-flexible cylindrical basket.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Terminal osculum is sealed by a perforated silicious sieve-plate.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Commensal association with Spongicola venusta shrimp.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Root tuft anchors sponge firmly in soft oceanic sediments.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'spongilla\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Freshwater Sponge\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Spongilla lacustris\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Demospongiae\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Spongillida\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Spongilla\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'lacustris\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-POR-004\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A rare freshwater sponge that survives harsh frozen winters by producing armored internal survival pods called gemmules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Colonial, encrusting or branched freshwater sponge colored bright emerald green due to symbiotic intracellular zoochlorellae algae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Clear, unpolluted freshwater ponds, lakes, quiet streams, and canals, attached to submerged tree branches, reeds, and stones.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Forms soft, irregularly branched or cushion-like encrustations on submerged logs. Color varies from dull yellowish-tan in shaded waters to vivid emerald green in sunlit waters due to endosymbiotic unicellular green algae (Zoochlorellae) living inside amoebocytes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Possesses a complex leuconoid canal system with rhagon-like flagellated chambers. The skeleton consists of silicious monaxon spicules bound together by soft organic spongin fibers. Pinacocytes contain contractile vacuoles for active freshwater osmoregulation.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Dual nutrition: filter feeds on aquatic bacteria, rotifers, and detritus via choanocyte chambers, supplemented by carbohydrates synthesized by symbiotic zoochlorellae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Exhibits gemmule formation\342\200\224an evolutionary adaptation for overwintering. When autumn approaches, internal asexual buds (gemmules) with thick amphidisc-reinforced amphicoel coats form. Gemmules survive desiccation and freezing, germinating the following spring.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Gemmule formation with micropyle and amphidisc spicules; symbiotic mutualism with Zoochlorellae algae; presence of osmoregulatory contractile vacuoles in sponge cells.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Bio-indicator of freshwater purity; plays a critical role in filtering organic particulates from lentic freshwater ecosystems.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Gemmules can survive temperatures below -20\302\260C and several months of complete dehydration.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If moved to a dark cave, Spongilla turns ghostly white as its photosynthetic green algae perish.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Archaeocytes inside gemmules are totipotent and can differentiate into all adult cell types.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Belongs to Class Demospongiae, which contains all freshwater sponges.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits a complex Leuconoid canal system with rounded flagellated chambers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of silicious monaxon spicules and spongin fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Overwinters through Gemmules protected by a pneumatic layer and amphidisc spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Osmoregulation achieved via contractile vacuoles inside pinacocytes and amoebocytes.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
