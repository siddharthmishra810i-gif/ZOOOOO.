        }
        lines {
          text: "      species: \'rubrum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-006\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'An ancient Mediterranean treasure with an intensely crimson axial skeleton prized for thousands of years in royal jewelry.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Sessile colonial octocoral with a hard, dense, porcelain-like crimson axial skeleton of fused calcium carbonate spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Arborescent scarlet branching colony with dense, hard calcareous axial skeleton and dimorphic white octocoral polyps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Sublittoral to bathyal zones (30\342\200\223300 m) on rocky crevices, dark caverns, and overhangs in the Mediterranean Sea and Eastern Atlantic.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Branching tree-like colony measuring 20 to 50 cm tall, with rigid, leafless scarlet or vermilion branches. The surface is covered by a soft living cortical layer (coenenchyme) from which pure white, flower-like polyps emerge.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Displays dimorphic polyps: autozooids (larger polyps with eight pinnate tentacles and digestive organs for feeding and reproduction) and siphonozooids (microscopic mouthless polyps functioning as water pumps through internal solenia canals). The central axial skeleton consists of crystalline magnesium-rich calcium carbonate tinted deep red by carotenoid pigments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Suspension feeder: autozooid polyps capture suspended organic matter, copepods, and micro-zooplankton carried by subterranean marine currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Gonochoric (separate sexes); internal fertilization with females brooding embryos until ciliated planula larvae are released.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Extremely dense, polishable red skeleton; dimorphism of polyps (autozooids and siphonozooids); exceptionally slow growth rate (2\342\200\2238 mm per year).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Historic and economic value as precious gemstone coral; heavily harvested since Roman antiquity, now strictly regulated under international conservation laws.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'In Greek mythology, red coral was born when Perseus placed the severed head of Medusa on sea reeds, whose blood petrified into red branches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'A mature colony can take over 100 years to reach the thickness of a human wrist.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The red color is so durable that Roman amulets carved over 2,000 years ago remain as intensely red today as when first harvested.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia (Alcyonaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Displays polyp dimorphism: Autozooids (feeding) and Siphonozooids (water circulation).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Solid axial skeleton formed of fused calcareous spicules colored by carotenoid pigments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps possess 8 pinnate tentacles, characteristic of all Octocorallia.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
