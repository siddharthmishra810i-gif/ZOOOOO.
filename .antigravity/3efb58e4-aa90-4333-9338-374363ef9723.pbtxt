        }
        lines {
          text: "    fact: \'Euplectella (Venus\\\' flower basket) is presented as a traditional wedding gift in Japan because a pair of commensal shrimp spend their entire adult lives enclosed together inside its glass lattice.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
