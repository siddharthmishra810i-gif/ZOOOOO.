          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-009\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A mutualistic sea anemone that wraps its body around a hermit crab shell, expanding the shell so the crab never outgrows it.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Solitary sea anemone that forms an obligate mutualistic symbiosis with hermit crabs, enveloping the gastropod shell like an elastic cloak.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Solitary sea anemone with a bilobed pedal disc wrapped around a hermit crab gastropod shell, equipped with acontia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    habitat: \'Sublittoral offshore muddy and gravelly sea floors (10\342\200\223200 m) in the North-East Atlantic and Mediterranean.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Basal pedal disc is greatly expanded and bilobed, wrapping completely around the gastropod shell occupied by the hermit crab (Pagurus prideaux). The mouth and tentacles face downward near the crab\342\200\231s walking legs. The column is pinkish-fawn with striking magenta or purple spots.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A hexacorallian sea anemone: tentacles and internal mesenteries occur in multiples of six. Around its base are specialized Cinclides\342\200\224pores through which long, white, venomous defensive threads called Acontia are fired when agitated.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Scavenger and carnivore: shares food scraps shredded by the hermit crab\342\200\231s feeding claws; also captures bottom worms and amphipods using tentacular nematocysts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Dioecious with external fertilization producing planula larvae that seek out juvenile hermit crabs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Secretes a chitinous membrane (carcinoecium) from its base that artificially extends the aperture of the crab\342\200\231s snail shell, so the crab never needs to seek a larger shell as it grows!\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Classic textbook demonstration of mutualistic symbiosis (protocooperation) between a cnidarian and an arthropod.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The hermit crab gently strokes the anemone with its claws to coax it onto a new shell, and the anemone willingly transfers without stinging the crab.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If attacked by an octopus, Adamsia fires hundreds of vivid violet acontia threads packed with nematocysts that drive the predator away.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The crab protects the anemone from starfish, while the anemone protects the crab from octopuses and fishes.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia (Actiniaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits obligate Mutualism with the hermit crab Pagurus prideaux.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possesses Cinclides and defensive Acontia (stinging threads).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Secretes chitinous carcinoecium extending the crab\342\200\231s gastropod shell.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
