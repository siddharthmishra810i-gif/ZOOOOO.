          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-PLA-002\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'An intestinal endoparasite measuring meters in length, armed with an apical rostellum of chitinous hooks and lacking any gut.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Ribbon-like segmented endoparasite infecting the human small intestine, armed with an anchor-bearing scolex and hundreds of reproductive proglottids.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Adult tapeworm lives attached to the mucosal lining of the human small intestine; larval stage (Cysticercus cellulosae) resides in the striated muscles of pigs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Elongated, ribbon-like, dorsoventrally flattened body (strobila) measuring 2 to 4 meters in length. Divided into three distinct regions: 1) Scolex (tiny knob-like head with four hemispherical suckers and an apical rostellum with 22\342\200\22332 chitinous hooks); 2) Unsegmented neck (zone of proliferation); 3) Strobila consisting of 800\342\200\2231,000 segments called proglottids (immature, mature, and gravid).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Completely lacks a mouth, pharynx, and digestive canal (alimentary system is 100% absent). The outer body is covered by a specialized syncytial tegument covered in millions of microscopic finger-like folds called microtriches, which maximize absorption of host nutrients. Flame cell excretory canals run along both margins.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Absorptive nutrition (saprozoic): absorbs glucose, amino acids, and fatty acids directly from host pre-digested chime across its microtriches-lined tegument.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Monoecious; each mature proglottid contains a complete set of male and female reproductive organs. Self-fertilization within or between proglottids is standard. Gravid proglottids at the posterior end contain a tree-like branched uterus packed with 30,000\342\200\22350,000 onchosphere eggs, which detach via apolysis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lifeCycle: \'Digenetic: Human (definitive host) passes gravid proglottids/eggs in stool \342\206\222 Ingested by pig (intermediate host) \342\206\222 Hexacanth embryo hatches in pig gut, penetrates vessels, and encysts in muscle as \"measly pork\" (Cysticercus cellulosae) \342\206\222 Human eats undercooked infected pork \342\206\222 Scolex everts in human intestine and grows into adult tapeworm.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Total absence of digestive system; presence of armed scolex with rostellum and dual hook ring; microtriches on tegument; causes human neurocysticercosis if eggs are accidentally ingested.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Major human pathogen causing Taeniasis (digestive discomfort) and Neurocysticercosis (larval cysts in the human brain causing epilepsy and death).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If a human accidentally swallows Taenia solium eggs directly, the larvae hatch inside the human body and form dangerous cysts in the brain, eyes, and muscles (Cysticercosis).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The tapeworm has evolved without a stomach or intestine for over 100 million years, letting its host do all the digestion.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Gravid proglottids can crawl like tiny caterpillars out of the human anus to deposit eggs in soil.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Cestoda, Order: Cyclophyllidea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body consists of Scolex (head with 4 suckers & armed rostellum), Neck, and Strobila.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Completely lacks digestive tract; nutrient absorption occurs via Tegument lined with Microtriches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Definitive host is Human; Intermediate host is Pig (Sus scrofa).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Larva is Cysticercus cellulosae (Bladder worm) with an invaginated scolex.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Apolysis is the shedding of gravid proglottids packed with hexacanth onchosphere eggs.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
