        lines {
          text: "    id: \'fungia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Mushroom Coral\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Fungia fungites\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
