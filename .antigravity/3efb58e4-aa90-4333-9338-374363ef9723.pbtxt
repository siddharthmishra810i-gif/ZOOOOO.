          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Octocorallia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Alcyonacea\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Alcyonium\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'digitatum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-007\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A fleshy, lobed colonial soft coral whose retracted winter form resembles ghostly, pale humanoid fingers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Fleshy, lobed colonial soft coral without a rigid axial skeleton, supported internally by isolated spicules embedded in thick mesoglea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Cold and temperate shallow seas of the North Atlantic, English Channel, and North Sea on rocky reefs with strong tidal currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Colony forms thick, spongy, lobed masses resembling swollen human fingers or hand-like lobes, up to 20 cm across. Color ranges from creamy white and dull yellow to orange. When underwater currents flow, hundreds of translucent, star-like polyps blossom across the lobes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Lacks a solid stony or horny skeleton. Structural support is provided by hydrostatic fluid pressure and numerous microscopic, dumbbell-shaped calcareous spicules (sclerites) scattered throughout the thick gelatinous coenenchyme. Polyps are monomorphic autozooids with eight pinnate tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Carnivorous passive filter feeder catching copepod nauplii and detritus in strong tidal currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Dioecious; synchronous mass spawning in mid-winter (December/January); external fertilization yields planula larvae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Leathery, fleshy texture; complete absence of a central axial rod; spectacular expansion and contraction cycles depending on tidal water movement.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Dominant space competitor in temperate European sublittoral ecosystems; model organism for studying soft coral chemical defense metabolites.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When exposed at extreme low tide or washed ashore, the contracted, mucus-covered lobes look astonishingly like severed human fingers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'During late autumn, the colony retracts all its polyps and covers itself in a brown biofilm for a month-long dormant cleansing rest.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Contains anti-predatory terpenes that deter predatory fish and sea urchins.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia (Alcyonaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Lacks a hard axial skeleton; supported by scattered calcareous sclerites in the mesoglea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Monomorphic polyps with 8 pinnate tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Colony consists of lobed, finger-like projections (hence the common name).\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'gorgonia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Sea Fan\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Gorgonia flabellum\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Octocorallia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Alcyonacea (Gorgonacea)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Gorgonia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'flabellum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-008\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A majestic planar lace of flexible gorgonin protein oriented perpendicular to reef surge currents to sift the tides.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Erect, fan-shaped colonial octocoral with an intricate network of interconnected flexible branches supported by a horn-like gorgonin skeleton.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Tropical shallow coral reefs and reef crests (2\342\200\22315 m) of the Bahamas, Florida Keys, and Caribbean Sea exposed to strong wave action.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Grows strictly in a single vertical plane, forming a flat, delicate mesh-like fan up to 1.5 meters wide and tall. Color is vivid purple, violet, or golden-yellow. The branches repeatedly divide and anastomose (re-fuse) to create a lace-like grid. The fan is always anchored by a broad basal disc.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'The central skeletal core is made of gorgonin\342\200\224a flexible, sulfur-rich, collagen-like fibrous protein. This axis is enveloped by living coenenchyme containing calcareous spicules and embedded gastrovascular tubes (solenia). Tiny polyps with eight pinnate tentacles project in rows along the edges of the branches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'The entire fan is oriented strictly perpendicular to the prevailing wave surge, functioning as a filtration grid to intercept zooplankton, suspended detritus, and marine snow.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Sexual reproduction with broadcast spawning of gametes; ciliated planulae settle on bare limestone; also capable of rapid asexual regeneration after storm damage.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Planar reticulate branching pattern; flexible gorgonin protein skeleton that bends without breaking in violent storm surge.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Creates 3D structural habitat on Caribbean reefs; provides shelter for basket stars, seahorses, and flamingo tongue snails.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The entire fan acts as a natural windsock: its growth orientation precisely records the direction of prevailing underwater currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Produces natural antifungal prostaglandins that protect its tissues from oceanic microbial infections.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The specialized Flamingo Tongue snail (Cyphoma gibbosum) feeds exclusively on sea fan coenenchyme without damaging the internal axis.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Central axis made of the horny scleroprotein Gorgonin.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Branches anastomose to form a planar network (fan-like flabellum).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps have 8 pinnate tentacles and 8 mesenteries.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
