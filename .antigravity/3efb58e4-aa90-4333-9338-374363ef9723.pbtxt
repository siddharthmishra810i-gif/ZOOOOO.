          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'musica\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-005\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A living architectural symphony of crimson calcareous tubes joined in tiers like the pipes of a cathedral organ.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Colonial octocoral with a brilliant crimson-red skeleton formed of vertical parallel tubes connected by horizontal platforms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Brilliant crimson calcareous skeleton of vertical parallel tubes linked by horizontal platforms, bearing emerald polyps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Shallow tropical coral reefs in warm, sunlit lagoons across the Indo-Pacific and Red Sea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Colony forms large hemispherical heads up to 1 meter across. The skeleton consists of numerous parallel, upright cylindrical tubes made of bright red calcium carbonate, linked together at intervals by horizontal platforms. Living polyps are emerald green with eight pinnate (feather-like) tentacles extending from the tube openings.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'An octocoral possessing eight mesenteries, eight pinnate tentacles, and a single ciliated siphonoglyph in the pharynx. The brilliant red skeleton is internal, formed by the fusion of calcareous spicules embedded in the mesoglea of the colony stolons and platforms. Iron salts impart the characteristic deep crimson color.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Mixotrophic: tentacles capture plankton, while endosymbiotic zooxanthellae residing in gastrodermal cells photosynthesize sugars and amino acids for the host.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Broadcast spawning of gametes into seawater; planula larvae disperse and settle on reef substrate to build new tubular colonies.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Unique organ-pipe skeletal architecture with vertical parallel tubes joined by transversal platforms; bright red skeleton that retains color even after dying and drying.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Important reef-building species; dried skeletons are prized worldwide as decorative natural history ornaments and in traditional crafts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When the living green polyps are extended, the bright red skeleton is completely hidden beneath a carpet of emerald tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The red color comes from iron salts integrated into the calcite crystals, not organic pigments, so it never fades in the sun.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Named \"musica\" by Carl Linnaeus because the arranged tubes look identical to church organ pipes.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia (Alcyonaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps possess exactly 8 pinnate (feather-like) tentacles and 8 complete mesenteries.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of fused red calcareous spicules forming vertical tubes and horizontal platforms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Color caused by iron oxide salts impregnated in the calcite matrix.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
