        lines {
          text: "    accessionNo: \'INV-CNI-010\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A quill-shaped colonial octocoral anchored into benthic silt, emitting waves of bioluminescent blue-green light when disturbed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Feather-like or quill-shaped colonial octocoral anchored upright in marine mud, renowned for vivid mechanical bioluminescence.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Soft, muddy, or sandy sea bottoms from 15 to 2,000 meters depth in the North Atlantic and Mediterranean.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Resembles an antique quill pen (15\342\200\22340 cm tall). The colony consists of a fleshy central stem: the lower unbranched stalk (peduncle) anchors in mud, while the upper axis (rachis) bears paired, bilateral lateral leaf-like pinnules lined with polyps. Color is carmine red, purple, or deep yellow.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A specialized colonial octocoral with high polymorphism: primary axial polyp (oozooid) forms the central stem supported by an uncalcified horny axial rod; secondary polyps on the lateral leaves consist of autozooids (feeding and reproduction with 8 pinnate tentacles) and siphonozooids (water-pumping polyps governing hydrostatic inflation of the peduncle).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Passive suspension filter feeder catching suspended organic particles and plankton in deep ocean currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Gonochoric broadcast spawner; planula larvae settle directly into muddy ocean sediments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Peduncle can pump water in and out to burrow or inflate/deflate; emits vivid green-blue bioluminescence when physically touched or stressed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Key structural species in deep muddy benthic shelf ecosystems; model organism in marine bioluminescence biophysics.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When brushed by a passing fish in total darkness, a brilliant wave of green light pulses down the length of the pen like a neon sign.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If severely disturbed, it can deflate its entire feather and retract completely beneath the surface of the mud within minutes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its specific name \"phosphorea\" directly references its glowing phosphorescent display.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia, Order: Pennatulacea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Colony differentiated into Peduncle (anchoring stalk) and Rachis (bearing lateral leaves).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polymorphism: Autozooids (feeding/reproduction) and Siphonozooids (hydrostatic regulation).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits marked Bioluminescence triggered by mechanical stimulation.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'fungia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Mushroom Coral\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Fungia fungites\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Hexacorallia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Scleractinia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Fungia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'fungites\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-011\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A massive solitary unattached coral resembling the cap of an inverted mushroom, capable of righting itself if flipped over.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Large, solitary, disk-shaped unattached stony coral with radiating septa resembling the gill-bearing underside of a mushroom.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Shallow tropical coral reefs (1\342\200\22325 m) resting unattached on sandy substrate or reef rubble across the Indo-Pacific.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Unlike most corals, the adult Fungia is entirely solitary and unattached. The hard calcareous corallum is flat or gently dome-shaped, circular to oval, measuring 15 to 30 cm across. A central slit-like oral opening sits on the upper surface surrounded by hundreds of sharp, radiating skeletal blades (septa).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A true scleractinian coral (Hexacorallia) with tentacles and septa in multiples of six. A single enormous polyp covers the entire upper surface of the limestone skeleton. The corallum is composed of pure aragonite (calcium carbonate). Tissues contain millions of intracellular zooxanthellae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Dual nutrition: relies heavily on photosynthetic energy from zooxanthellae; at night, short tentacles expand to capture zooplankton, small shrimp, and worms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Exhibits unique biphasic life history: planula larva settles and forms an attached stalked juvenile (anthocaulus). The disk then detaches like a mushroom cap (anthocyathus) to live freely on the sand, while the stalk can bud additional caps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Adult is solitary and unattached; possesses mobility: can inflate its tissues with seawater to right itself if overturned by storm waves, or shed sand by ciliary mucus currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Critical reef-flat organism; vital bio-model for studying skeletal aragonite biomineralization and coral locomotion.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If flipped upside-down by a turtle or rough waves, Fungia slowly pumps its tissues full of water like an airbag to flip itself back right-side up.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'It is one of the largest single coral polyps in existence, with some solitary specimens exceeding 40 cm in diameter.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Can crawl slowly across sandy patches by inflating and deflating different quadrants of its body wall.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia, Order: Scleractinia (true stony corals).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Adult is Solitary and Unattached (free-living on sandy reef flats).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of Aragonite with radiating blade-like Septa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Juvenile stage is a stalked Anthocaulus; adult free disk is an Anthocyathus.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
