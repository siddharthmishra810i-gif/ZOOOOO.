          text: "      genus: \'Gorgonia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'flabellum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-008\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A majestic planar lace of flexible gorgonin protein oriented perpendicular to reef surge currents to sift the tides.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Erect, fan-shaped colonial octocoral with an intricate network of interconnected flexible branches supported by a horn-like gorgonin skeleton.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Flat, planar, reticulate sea fan with interconnected branches supported by a flexible horny axial rod of gorgonin protein.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Tropical shallow coral reefs and reef crests (2\342\200\22315 m) of the Bahamas, Florida Keys, and Caribbean Sea exposed to strong wave action.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Grows strictly in a single vertical plane, forming a flat, delicate mesh-like fan up to 1.5 meters wide and tall. Color is vivid purple, violet, or golden-yellow. The branches repeatedly divide and anastomose (re-fuse) to create a lace-like grid. The fan is always anchored by a broad basal disc.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'The central skeletal core is made of gorgonin\342\200\224a flexible, sulfur-rich, collagen-like fibrous protein. This axis is enveloped by living coenenchyme containing calcareous spicules and embedded gastrovascular tubes (solenia). Tiny polyps with eight pinnate tentacles project in rows along the edges of the branches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'The entire fan is oriented strictly perpendicular to the prevailing wave surge, functioning as a filtration grid to intercept zooplankton, suspended detritus, and marine snow.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Sexual reproduction with broadcast spawning of gametes; ciliated planulae settle on bare limestone; also capable of rapid asexual regeneration after storm damage.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Planar reticulate branching pattern; flexible gorgonin protein skeleton that bends without breaking in violent storm surge.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Creates 3D structural habitat on Caribbean reefs; provides shelter for basket stars, seahorses, and flamingo tongue snails.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The entire fan acts as a natural windsock: its growth orientation precisely records the direction of prevailing underwater currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Produces natural antifungal prostaglandins that protect its tissues from oceanic microbial infections.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The specialized Flamingo Tongue snail (Cyphoma gibbosum) feeds exclusively on sea fan coenenchyme without damaging the internal axis.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Central axis made of the horny scleroprotein Gorgonin.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Branches anastomose to form a planar network (fan-like flabellum).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps have 8 pinnate tentacles and 8 mesenteries.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
