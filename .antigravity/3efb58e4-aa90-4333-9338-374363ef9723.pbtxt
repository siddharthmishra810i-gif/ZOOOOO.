          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'meandrina\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Brain Coral\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Meandrina meandrites\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
