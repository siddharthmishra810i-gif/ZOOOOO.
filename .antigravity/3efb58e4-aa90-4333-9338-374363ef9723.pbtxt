          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'alcyonium\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \"Dead Man\'s Fingers\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Alcyonium digitatum\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
