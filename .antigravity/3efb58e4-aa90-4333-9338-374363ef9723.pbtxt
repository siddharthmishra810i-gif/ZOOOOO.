        }
        lines {
          text: "      \'Unsegmented, cylindrical, elongated worms with tapering pointed ends.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body cavity is a Pseudocoelom maintained under high hydrostatic pressure.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Complete digestive tract with anterior mouth, muscular pharynx, and posterior anus.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possess a non-living tough cuticle periodically shed through ecdysis (molting).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body wall possesses ONLY longitudinal muscle fibers; circular muscles are completely absent.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibit pronounced sexual dimorphism (males smaller with curved tail and copulatory spicules).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Renette cells or H-shaped canal system serve in excretion and osmoregulation.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
