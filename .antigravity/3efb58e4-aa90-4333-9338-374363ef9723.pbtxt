          text: "export const phylaData: Phylum[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Pore-bearing Animals (Sponges)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    etymology: \'Latin porus (pore) + ferre (to bear)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Primitive multicellular, sedentary aquatic organisms with cellular-grade organization and a distinctive aquiferous canal system.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    overview: \'Phylum Porifera comprises the simplest multicellular animals (Metazoa), historically placed in Parazoa because their cells do not form genuine tissues, organs, or germ layers. They are sessile, filter-feeding invertebrates with thousands of incurrent pores (ostia) and a central excurrent opening (osculum), supported by an internal skeleton of mineralized spicules or collagenous spongin fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    generalCharacteristics: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyOrganization: \'Cellular level of body organization; cells exhibit division of labor but lack true basement membranes or synaptic junctions.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      symmetry: \'Mostly asymmetrical, with some radial or urn-shaped forms (e.g., Sycon).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      levelOfOrganization: \'Cellular grade (Parazoa) with loose aggregation of specialized cells (pinacocytes, choanocytes, amoebocytes).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      germLayers: \'Diploblastic-like in anatomical arrangement with outer pinacoderm and inner choanoderm separated by a gelatinous mesohyl layer, though distinct embryological germ layers are absent.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      coelom: \'Acoelomate; the primary internal space is the spongocoel (paragastric cavity), which is not a true gut or coelom.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyWall: \'Perforated by thousands of incurrent ostia and lined externally by pinacocytes and internally by flagellated choanocytes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      canalOrCavity: \'Unique aquiferous canal system (Asconoid, Syconoid, or Leuconoid) responsible for water circulation, food capture, gas exchange, and waste removal.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      digestion: \'Strictly intracellular; choanocytes ingest microscopic food particles via phagocytosis and transfer nutrients to amoebocytes (trophocytes) for digestion and distribution.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      respiration: \'Simple direct aerobic diffusion across cell membranes into the circulating water current; specialized respiratory organs are absent.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      excretion: \'Excretion of ammonia (ammonotelic) by simple diffusion across cell surfaces into the water current; contractile vacuoles regulate osmolarity in freshwater sponges.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      nervousSystem: \'Devoid of true neurons, synapses, or sensory organs; coordination relies on local mechanical contraction of myocytes surrounding pores.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      reproduction: \'Both asexual (budding, fragmentation, gemmules in freshwater forms) and sexual (mostly hermaphroditic; choanocytes transform into sperm, amoebocytes into ova; free-swimming amphiblastula or parenchymula larvae).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      skeleton: \'Internal skeletal matrix composed of calcareous or silicious spicules (mono-, tri-, or tetraxons) and/or flexible proteinaceous spongin fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ecologicalImportance: \'Essential benthic filter feeders that clear coastal waters, cycle silicon and organic carbon, and host diverse symbiotic microorganisms and commensal crustaceans.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    atAGlance: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Porifera\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      organization: \'Cellular grade (Parazoa)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      symmetry: \'Asymmetrical or radial\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      habitat: \'Mostly marine; family Spongillidae in freshwater\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      germLayers: \'Diploblastic organization (Pinacoderm & Choanoderm)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      coelom: \'Absent (spongocoel present)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      examples: [\'Sycon\', \'Hyalonema\', \'Euplectella\', \'Spongilla\']"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specimenIds: [\'sycon\', \'hyalonema\', \'euplectella\', \'spongilla\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    revisionPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Cellular grade of organization without true tissues or germ layers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possess characteristic flagellated collar cells called Choanocytes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Perforated by incurrent pores (Ostia) and one/more excurrent apertures (Osculum).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Presence of an Aquiferous Canal System driving continuous water flow.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Digestion is exclusively intracellular inside food vacuoles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of crystalline spicules (calcium carbonate or silica) and/or spongin fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Larval stages are ciliated and free-swimming (Amphiblastula or Parenchymula).\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomicalDiagram: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Syconoid Canal System Flow (Sycon)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Water circulation pathway driven by coordinated beats of choanocyte flagella\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsOrParts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Dermal Ostia\', description: \'Microscopic incurrent pores on the exterior surface.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Incurrent Canals\', description: \'Tubular channels lined by pinacocytes passing water inward.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Prosopyles\', description: \'Microscopic apertures connecting incurrent canals to radial canals.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Radial Canals\', description: \'Flagellated chambers lined with active food-filtering choanocytes.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Apopyles\', description: \'Internal pores through which filtered water exits radial canals.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Spongocoel\', description: \'Central paragastric cavity lined by pinacocytes.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Osculum\', description: \'Terminal wide aperture expelling filtered water into the environment.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Coelenterata / Stinging Animals\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    etymology: \'Greek knide (nettle) + aria (connected with)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Diploblastic, radially symmetrical metazoans possessing stinging cell organelles (cnidocytes) and a gastrovascular cavity.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    overview: \'Phylum Cnidaria comprises diverse aquatic invertebrates including hydroids, jellyfish, sea anemones, and reef-building corals. They represent the earliest evolutionary lineage with true tissues and organized nerve nets. Their hallmark evolutionary innovation is the cnidocyte\342\200\224an explosive cellular capsule containing a coiled venomous thread (nematocyst) used for prey capture and defense.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    generalCharacteristics: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyOrganization: \'Tissue grade of body organization with specialized cellular layers and primitive epitheliomuscular tissue.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      symmetry: \'Radial or biradial symmetry around a central oral-aboral axis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      levelOfOrganization: \'Tissue grade; possess epidermis, gastrodermis, and an intervening acellular/cellular mesoglea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      germLayers: \'Diploblastic, derived embryologically from ectoderm and endoderm.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      coelom: \'Acoelomate; primary internal chamber is the coelenteron (gastrovascular cavity) with a single opening serving as both mouth and anus.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyWall: \'Outer epidermis and inner gastrodermis separated by jelly-like mesoglea containing wandering amoeboid cells.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      canalOrCavity: \'Gastrovascular cavity (coelenteron) functioning simultaneously in digestion, internal transport, and hydrostatic support.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      digestion: \'Both extracellular and intracellular: enzymes secreted into the gastrovascular cavity break down prey before nutritive-muscular cells engulf fragments via phagocytosis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      respiration: \'Aerobic gas exchange occurs by direct diffusion across all body surfaces exposed to ambient water.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      excretion: \'Excretion of metabolic ammonia via simple diffusion directly through the epidermal and gastrodermal cell layers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      nervousSystem: \'Primitive diffuse nerve net (subepithelial neural plexus) lacking a centralized brain or ganglia, with bi-directional impulse conduction.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      reproduction: \'Metagenesis (alternation of generations) between an asexual sessile polyp and a sexual free-swimming medusa in many taxa; planula larva is standard.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      skeleton: \'Hydrostatic skeleton in polyps and medusae; rigid external or internal calcareous skeletons in corals (calcium carbonate) or horny gorgonin in sea fans.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ecologicalImportance: \'Reef-building stony corals form biodiverse marine ecosystems supporting 25% of all ocean life; key pelagic predators in coastal trophic webs.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    atAGlance: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      organization: \'Tissue grade (Eumetazoa)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      symmetry: \'Radial or biradial\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      habitat: \'Almost exclusively marine; Hydra in freshwater\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      germLayers: \'Diploblastic (Ectoderm and Endoderm)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      coelom: \'Absent (Gastrovascular cavity present)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      examples: [\'Obelia\', \'Physalia\', \'Millepora\', \'Aurelia\', \'Tubipora\', \'Corallium\', \'Alcyonium\', \'Gorgonia\', \'Adamsia\', \'Pennatula\', \'Fungia\', \'Meandrina\', \'Madrepora\']"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specimenIds: [\'obelia\', \'physalia\', \'millepora\', \'aurelia\', \'tubipora\', \'corallium\', \'alcyonium\', \'gorgonia\', \'adamsia\', \'pennatula\', \'fungia\', \'meandrina\', \'madrepora\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    revisionPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Tissue grade of organization, radially symmetrical and diploblastic.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Possess specialized stinging cells called Cnidocytes containing Nematocysts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body plan features two distinct morphs: sessile cylindrical Polyp and motile umbrella-shaped Medusa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Single opening (hypostome mouth) connects gastrovascular cavity to exterior (incomplete gut).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Digestion is initially extracellular in the coelenteron, completed intracellularly.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Nervous system forms a primitive non-polarized diffuse nerve net.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibit metagenesis (alternation between asexual polyp and sexual medusa generations).\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomicalDiagram: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Cnidocyte / Nematocyst Discharge Mechanism\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'The fastest cellular biomechanical event in nature (~700 nanoseconds)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsOrParts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Cnidocil\', description: \'Hair-like sensory trigger receptor on epidermal surface.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Operculum\', description: \'Hinged lid that seals the pressurized cnidocyte capsule.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Osmotic Influx\', description: \'Triggering causes massive calcium and water influx, spiking internal pressure to 150 atmospheres.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Eversion\', description: \'Inverted tubular thread is violently propelled inside-out at 5,000,000 g acceleration.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Barbs & Stylets\', description: \'Penetrate target integument to anchor the hollow filament.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Toxin Delivery\', description: \'Neurotoxic and cytolytic polypeptides injected into prey circulation.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'ctenophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \'Ctenophora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Comb Jellies / Sea Walnuts\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    etymology: \'Greek ktenos (comb) + phoros (bearing)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Biradially symmetrical, pelagic, transparent marine animals characterized by eight rows of ciliated comb plates and adhesive colloblasts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    overview: \'Phylum Ctenophora comprises graceful, gelatinous marine animals colloquially called comb jellies or sea gooseberries. While superficially resembling cnidarian jellyfish, they lack nematocysts entirely, swim using the coordinated rhythmic beating of eight meridional rows of giant fused cilia (ctenes), and capture zooplankton using sticky glue-secreting cells (colloblasts). Almost all species exhibit brilliant bioluminescence and ciliary iridescence.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    generalCharacteristics: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyOrganization: \'Tissue-organ grade of body organization, with true muscle cells derived from the mesenchyme (cellular mesoglea).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      symmetry: \'Biradial symmetry around the oral-aboral axis, determined by paired tentacles and the stomodeum.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      levelOfOrganization: \'Tissue-organ grade with specialized aboral sense organ, complex pharynx, and branching gastrovascular canals.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      germLayers: \'Diploblastic / Triploblastic according to modern zoological debate, possessing a thick cellular mesenchyme with true smooth muscle fibers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      coelom: \'Acoelomate; primary space is occupied by voluminous gelatinous mesoglea with amoebocytes and muscle cells.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      bodyWall: \'Delicate external epidermis, thick internal mesoglea, and inner gastrodermis lining the stomodeal gut system.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      canalOrCavity: \'Mouth opens into a long muscular stomodeum (pharynx) branching into a system of eight meridional and interradial canals terminating near anal pores.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      digestion: \'Both extracellular (in stomodeum) and intracellular (within gastrodermal cells lining canals); unlike cnidarians, ctenophores possess anal pores.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      respiration: \'Gas exchange occurs entirely by direct diffusion across the delicate body surface into seawater.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      excretion: \'Metabolic ammonia eliminated through body surface and anal pores at the aboral pole.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      nervousSystem: \'Subepidermal diffuse nerve plexus concentrated under the eight comb rows, coordinated by a complex sensory statocyst at the aboral pole.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      reproduction: \'Hermaphroditic (monoecious); external fertilization; distinctive cydippid larval stage with tentacle sheaths.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      skeleton: \'Exclusively hydrostatic; firm gelatinous mesoglea supports shape and resists hydrostatic compression in the water column.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ecologicalImportance: \'Significant pelagic predators of copepods, fish eggs, and mollusk larvae; invasive Mnemiopsis caused dramatic shifts in the Black Sea ecosystem.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    atAGlance: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
