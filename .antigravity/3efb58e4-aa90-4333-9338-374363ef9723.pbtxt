        lines {
          text: "      title: \'Taenia solium Proglottid Strobilation Flow\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      path: [\'Scolex & Neck (Proliferation Zone)\', \'Immature Proglottids (Organ buds)\', \'Mature Proglottids (Functional gonads)\', \'Gravid Proglottids (Branched uterus + eggs)\', \'Apolysis (Detachment in feces)\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Continuous budding at the neck generates hundreds of progressively maturing proglottids that become egg-filled sacs released by apolysis.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
