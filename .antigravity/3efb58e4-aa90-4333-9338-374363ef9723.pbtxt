          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Octocorallia (Alcyonaria)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Alcyonacea\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Tubipora\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'musica\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-005\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A living architectural symphony of crimson calcareous tubes joined in tiers like the pipes of a cathedral organ.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Colonial octocoral with a brilliant crimson-red skeleton formed of vertical parallel tubes connected by horizontal platforms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Shallow tropical coral reefs in warm, sunlit lagoons across the Indo-Pacific and Red Sea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Colony forms large hemispherical heads up to 1 meter across. The skeleton consists of numerous parallel, upright cylindrical tubes made of bright red calcium carbonate, linked together at intervals by horizontal platforms. Living polyps are emerald green with eight pinnate (feather-like) tentacles extending from the tube openings.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'An octocoral possessing eight mesenteries, eight pinnate tentacles, and a single ciliated siphonoglyph in the pharynx. The brilliant red skeleton is internal, formed by the fusion of calcareous spicules embedded in the mesoglea of the colony stolons and platforms. Iron salts impart the characteristic deep crimson color.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Mixotrophic: tentacles capture plankton, while endosymbiotic zooxanthellae residing in gastrodermal cells photosynthesize sugars and amino acids for the host.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Broadcast spawning of gametes into seawater; planula larvae disperse and settle on reef substrate to build new tubular colonies.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Unique organ-pipe skeletal architecture with vertical parallel tubes joined by transversal platforms; bright red skeleton that retains color even after dying and drying.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Important reef-building species; dried skeletons are prized worldwide as decorative natural history ornaments and in traditional crafts.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When the living green polyps are extended, the bright red skeleton is completely hidden beneath a carpet of emerald tentacles.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The red color comes from iron salts integrated into the calcite crystals, not organic pigments, so it never fades in the sun.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Named \"musica\" by Carl Linnaeus because the arranged tubes look identical to church organ pipes.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia (Alcyonaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps possess exactly 8 pinnate (feather-like) tentacles and 8 complete mesenteries.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of fused red calcareous spicules forming vertical tubes and horizontal platforms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Color caused by iron oxide salts impregnated in the calcite matrix.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'corallium\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Precious Red Coral\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Corallium rubrum\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    phylumId: \'cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    classification: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kingdom: \'Animalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      phylum: \'Cnidaria\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      class: \'Anthozoa\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subclass: \'Octocorallia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      order: \'Alcyonacea\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      genus: \'Corallium\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      species: \'rubrum\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-006\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'An ancient Mediterranean treasure with an intensely crimson axial skeleton prized for thousands of years in royal jewelry.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Sessile colonial octocoral with a hard, dense, porcelain-like crimson axial skeleton of fused calcium carbonate spicules.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Sublittoral to bathyal zones (30\342\200\223300 m) on rocky crevices, dark caverns, and overhangs in the Mediterranean Sea and Eastern Atlantic.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Branching tree-like colony measuring 20 to 50 cm tall, with rigid, leafless scarlet or vermilion branches. The surface is covered by a soft living cortical layer (coenenchyme) from which pure white, flower-like polyps emerge.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Displays dimorphic polyps: autozooids (larger polyps with eight pinnate tentacles and digestive organs for feeding and reproduction) and siphonozooids (microscopic mouthless polyps functioning as water pumps through internal solenia canals). The central axial skeleton consists of crystalline magnesium-rich calcium carbonate tinted deep red by carotenoid pigments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Suspension feeder: autozooid polyps capture suspended organic matter, copepods, and micro-zooplankton carried by subterranean marine currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Gonochoric (separate sexes); internal fertilization with females brooding embryos until ciliated planula larvae are released.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Extremely dense, polishable red skeleton; dimorphism of polyps (autozooids and siphonozooids); exceptionally slow growth rate (2\342\200\2238 mm per year).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Historic and economic value as precious gemstone coral; heavily harvested since Roman antiquity, now strictly regulated under international conservation laws.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'In Greek mythology, red coral was born when Perseus placed the severed head of Medusa on sea reeds, whose blood petrified into red branches.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'A mature colony can take over 100 years to reach the thickness of a human wrist.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The red color is so durable that Roman amulets carved over 2,000 years ago remain as intensely red today as when first harvested.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia (Alcyonaria).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Displays polyp dimorphism: Autozooids (feeding) and Siphonozooids (water circulation).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Solid axial skeleton formed of fused calcareous spicules colored by carotenoid pigments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polyps possess 8 pinnate tentacles, characteristic of all Octocorallia.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
