        }
        lines {
          text: "    accessionNo: \'INV-CNI-012\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    spotlightQuote: \'A massive hermatypic coral whose meandering labyrinth of valleys and ridges mirrors the convolutions of the human cerebrum.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    shortDescription: \'Massive hemispherical stony coral featuring winding, sinuous corallite valleys separated by steep ridges resembling human cerebral gyri.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    habitat: \'Shallow to mid-depth tropical reefs (3\342\200\22330 m) throughout the Caribbean Sea, Bahamas, and Gulf of Mexico.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    morphology: \'Forms solid hemispherical domes or robust columnar boulders up to 1 meter in diameter. The skeletal surface is covered in deep, meandering valleys (1\342\200\2232 cm wide) that wind continuously across the surface. At night, translucent tentacles expand from the valleys to feed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anatomy: \'A colonial scleractinian with meandroid corallite integration: adjacent polyps fuse linearly within the valleys, sharing a common gastrovascular groove and mouth series while retaining distinct septal ridges (collines). The skeleton is dense, massive aragonite.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nutrition: \'Mixotrophic: daytime nutrition from symbiotic zooxanthellae; nocturnal extension of sweeping tentacular nets to capture pelagic zooplankton.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    reproduction: \'Simultaneous hermaphroditic broadcast spawner during late-summer lunar spawning events; planulae settle to begin new colonies.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    specialFeatures: \'Meandroid colony integration; deep robust septa with fine denticulations; high structural density providing storm resistance to Caribbean reefs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    importance: \'Primary framework builder of Western Atlantic coral reefs; provides immense calcium carbonate accretion and shoreline wave protection.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Colonies can live for over 400 years, with annual growth bands in their skeletons recording past ocean temperatures like tree rings.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Despite looking like a single brain, the colony contains thousands of interconnected individual coral polyps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Possesses extraordinary resistance to heavy sedimentation by producing self-cleaning mucus sheets.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia, Order: Scleractinia.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Exhibits Meandroid colony growth where corallites fuse into continuous winding valleys.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Skeletal ridges are called Collines; valleys contain the oral apertures.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Major Hermatypic (reef-building) coral with aragonite skeleton.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
