          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-011\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A massive solitary unattached coral resembling the cap of an inverted mushroom, capable of righting itself if flipped over.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Large, solitary, disk-shaped unattached stony coral with radiating septa resembling the gill-bearing underside of a mushroom.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Solitary, unattached circular stony corallum with radiating blade-like septa resembling an inverted mushroom cap.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    habitat: \'Shallow tropical coral reefs (1\342\200\22325 m) resting unattached on sandy substrate or reef rubble across the Indo-Pacific.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Unlike most corals, the adult Fungia is entirely solitary and unattached. The hard calcareous corallum is flat or gently dome-shaped, circular to oval, measuring 15 to 30 cm across. A central slit-like oral opening sits on the upper surface surrounded by hundreds of sharp, radiating skeletal blades (septa).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A true scleractinian coral (Hexacorallia) with tentacles and septa in multiples of six. A single enormous polyp covers the entire upper surface of the limestone skeleton. The corallum is composed of pure aragonite (calcium carbonate). Tissues contain millions of intracellular zooxanthellae.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Dual nutrition: relies heavily on photosynthetic energy from zooxanthellae; at night, short tentacles expand to capture zooplankton, small shrimp, and worms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Exhibits unique biphasic life history: planula larva settles and forms an attached stalked juvenile (anthocaulus). The disk then detaches like a mushroom cap (anthocyathus) to live freely on the sand, while the stalk can bud additional caps.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Adult is solitary and unattached; possesses mobility: can inflate its tissues with seawater to right itself if overturned by storm waves, or shed sand by ciliary mucus currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Critical reef-flat organism; vital bio-model for studying skeletal aragonite biomineralization and coral locomotion.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If flipped upside-down by a turtle or rough waves, Fungia slowly pumps its tissues full of water like an airbag to flip itself back right-side up.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'It is one of the largest single coral polyps in existence, with some solitary specimens exceeding 40 cm in diameter.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Can crawl slowly across sandy patches by inflating and deflating different quadrants of its body wall.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Hexacorallia, Order: Scleractinia (true stony corals).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Adult is Solitary and Unattached (free-living on sandy reef flats).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Skeleton composed of Aragonite with radiating blade-like Septa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Juvenile stage is a stalked Anthocaulus; adult free disk is an Anthocyathus.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
