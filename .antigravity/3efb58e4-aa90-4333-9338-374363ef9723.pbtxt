          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      phylum: \'Nemathelminthes (Nematoda)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      class: \'Secernentea (Phasmida)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      order: \'Ascaridida\',"
