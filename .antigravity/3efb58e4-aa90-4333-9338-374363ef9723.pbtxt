          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    accessionNo: \'INV-CNI-010\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A quill-shaped colonial octocoral anchored into benthic silt, emitting waves of bioluminescent blue-green light when disturbed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Feather-like or quill-shaped colonial octocoral anchored upright in marine mud, renowned for vivid mechanical bioluminescence.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    identification: \'Fleshy quill-shaped colony with an anchoring peduncle and an upper bilateral leaf-bearing rachis exhibiting bioluminescence.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Soft, muddy, or sandy sea bottoms from 15 to 2,000 meters depth in the North Atlantic and Mediterranean.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Resembles an antique quill pen (15\342\200\22340 cm tall). The colony consists of a fleshy central stem: the lower unbranched stalk (peduncle) anchors in mud, while the upper axis (rachis) bears paired, bilateral lateral leaf-like pinnules lined with polyps. Color is carmine red, purple, or deep yellow.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'A specialized colonial octocoral with high polymorphism: primary axial polyp (oozooid) forms the central stem supported by an uncalcified horny axial rod; secondary polyps on the lateral leaves consist of autozooids (feeding and reproduction with 8 pinnate tentacles) and siphonozooids (water-pumping polyps governing hydrostatic inflation of the peduncle).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Passive suspension filter feeder catching suspended organic particles and plankton in deep ocean currents.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Gonochoric broadcast spawner; planula larvae settle directly into muddy ocean sediments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Peduncle can pump water in and out to burrow or inflate/deflate; emits vivid green-blue bioluminescence when physically touched or stressed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Key structural species in deep muddy benthic shelf ecosystems; model organism in marine bioluminescence biophysics.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'When brushed by a passing fish in total darkness, a brilliant wave of green light pulses down the length of the pen like a neon sign.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'If severely disturbed, it can deflate its entire feather and retract completely beneath the surface of the mud within minutes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Its specific name \"phosphorea\" directly references its glowing phosphorescent display.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Anthozoa, Subclass: Octocorallia, Order: Pennatulacea.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Colony differentiated into Peduncle (anchoring stalk) and Rachis (bearing lateral leaves).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Polymorphism: Autozooids (feeding/reproduction) and Siphonozooids (hydrostatic regulation).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Exhibits marked Bioluminescence triggered by mechanical stimulation.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
