        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fact: \'Physalia physalis (Portuguese man-of-war) is not a single animal, but a floating colony composed of thousands of genetically identical specialized zooids sharing one continuous stomach.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    specimenId: \'physalia\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    phylumId: \'cnidaria\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
