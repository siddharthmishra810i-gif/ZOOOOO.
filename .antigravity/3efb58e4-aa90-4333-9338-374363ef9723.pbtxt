        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fact: \'Millepora (Fire coral) is not a true coral, but a hydrozoan closely related to Hydra. Its stinging dactylozooids cause intense burning contact dermatitis in divers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    specimenId: \'millepora\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
