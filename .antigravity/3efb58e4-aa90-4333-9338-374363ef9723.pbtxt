        }
        lines {
          text: "    accessionNo: \'INV-NEM-001\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    spotlightQuote: \'A cylindrical pseudocoelomate endoparasite encased in a collagenous cuticle, embarking on an extraordinary migratory journey through host lungs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    shortDescription: \'Large, unsegmented cylindrical roundworm living as an endoparasite in the human small intestine, exhibiting pronounced sexual dimorphism.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    habitat: \'Lumen of the human small intestine (jejunum and ileum); free-living eggs develop in warm, moist, contaminated soil.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    morphology: \'Elongated, cylindrical, pale yellowish-pink body tapering at both anterior and posterior extremities. Marked sexual dimorphism: females are longer (20\342\200\22340 cm) and thicker with a straight conical posterior end; males are distinctly smaller (15\342\200\22330 cm) with a ventrally curved posterior tail bearing two equal chitinous copulatory spicules (penial setae) projecting from the cloaca. Body wall displays four longitudinal streaks (one dorsal, one ventral, two lateral).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    anatomy: \'Body wall composed of: 1) Non-living tough cuticle with lipid and collagen layers; 2) Syncytial hypodermis bulging inward to form four chords; 3) Single layer of longitudinal muscle fibers divided into four quadrants (circular muscles absent). Body cavity is a fluid-filled pseudocoelom under high turgor pressure. Alimentary canal is complete: anterior mouth guarded by three sensory lips (one dorsal, two subventral), muscular pharynx, straight non-muscular tubular intestine, and posterior anus (or cloaca in males).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    nutrition: \'Holozoic saprozoic: feeds on host pre-digested food pulp present in the intestinal lumen, pumped inward by the rhythmic swallowing action of its muscular triradiate pharynx.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    reproduction: \'Dioecious (unisexual) with internal fertilization. Female reproductive system is didelphic (paired ovaries, oviducts, and uteri opening into a single vulva at the anterior third). A single female produces up to 200,000 mamillated eggs per day.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lifeCycle: \'Monogenetic (single host): Adult in human intestine \342\206\222 Fertilized eggs passed in stool \342\206\222 Embryonate in soil (rhabditiform larva develops inside egg shell) \342\206\222 Contaminated food/water ingested by human \342\206\222 Larva hatches in duodenum, penetrates mucosa into mesenteric venules \342\206\222 Liver (hepatic portal system) \342\206\222 Right heart \342\206\222 Pulmonary capillaries \342\206\222 Alveoli of lungs (grows and molts) \342\206\222 Ascends trachea and larynx \342\206\222 Swallowed down esophagus into stomach \342\206\222 Small intestine, maturing into adult worm.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    specialFeatures: \'Complete digestive tract with 3 sensory lips; high-pressure pseudocoelom; absence of circular muscles; elaborate pulmonary migration cycle of larvae through the host circulatory system and lungs.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    importance: \'Causes Ascariasis worldwide; causes intestinal blockage, malnutrition in children, appendicitis, and Loeffler\342\200\231s syndrome (verminous pneumonia during lung migration).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    interestingFacts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'A female Ascaris can lay up to 200,000 eggs every single day\342\200\224over 60 million eggs in her lifetime!\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The microscopic larva travels over 3,000 miles inside the human bloodstream, passing through liver, heart, and lungs before being coughed up and swallowed back into the belly.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The thick chitinous and proteinaceous egg shell can survive in soil soaked in 10% formalin for months.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    examPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Class: Secernentea (Phasmida) \342\200\224 possesses caudal sensory phasmids.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Pronounced sexual dimorphism: Male smaller with curved tail and 2 equal copulatory spicules; Female larger with straight tail and vulva at anterior third.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Body wall contains ONLY longitudinal muscles (polymyarian/meromyarian condition); circular muscles are absent.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Pseudocoelomate body cavity filled with pressurized pseudocoelomic fluid.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Mouth surrounded by 3 sensory lips: 1 median dorsal lip and 2 ventrolateral lips.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Larval pulmonary migration: Intestine \342\206\222 Mesenteric veins \342\206\222 Liver \342\206\222 Heart \342\206\222 Lungs (alveoli) \342\206\222 Trachea \342\206\222 Pharynx \342\206\222 Intestine.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
