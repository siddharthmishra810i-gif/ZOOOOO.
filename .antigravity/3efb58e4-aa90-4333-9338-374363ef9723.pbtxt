        lines {
          text: "    id: \'taenia\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    commonName: \'Pork Tapeworm\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scientificName: \'Taenia solium\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
