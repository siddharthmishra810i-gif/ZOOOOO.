        }
        lines {
          text: "      description: \'Cross-sectional mechanics generating characteristic S-shaped thrashing locomotion\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsOrParts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Cuticle\', description: \'Multilayered resistant collagenous sheath resisting host digestive enzymes.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Syncytial Hypodermis\', description: \'Multinucleate cellular layer projecting into 4 longitudinal chords.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Longitudinal Muscle Bands\', description: \'Four fields of muscle cells sending cytoplasmic arms to nerve cords.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Pseudocoelom\', description: \'Pressurized fluid cavity functioning as an antagonistic hydrostatic skeleton.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { name: \'Tubular Gut\', description: \'Endodermal non-muscular intestine bathed directly in pseudocoelomic nutrients.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
